        },
        {
          "old": "sub_08119980",
          "proposed": "SwitchMain",
          "baseline_evidence": "Calls press-state update, sets sprite state, dispatches template effects, increments counter.",
          "limitation": "Four effect routes exist, one intentionally remains unnamed."
        },
        {
          "old": "sub_08119A20",
          "proposed": "SwitchUpdateHeldCount",
          "baseline_evidence": "Increments room slot on press-edge bit; decrements on release-edge bit only when nonzero.",
          "limitation": "This is a shared room slot, not a count of allocated objects."
        },
        {
          "old": "sub_08119B3C",
          "proposed": "SwitchTryWorldMapUnlock",
          "baseline_evidence": "Marks pending after press, gates callback table dispatch on CanStartInGameInterlude.",
          "limitation": "Request can wait; avoid an unconditional Start or Unlock name."
        },
        {
          "old": "sub_08119BB8",
          "proposed": "SwitchUpdateCPUKirbyTrigger",
          "baseline_evidence": "Also updates held count; raises room slot0xF while held. Same slot appears in cpu_kirby_trigger.c and CPU script reader.",
          "limitation": "Per-template threshold; not proof that every switch triggers CPU AI."
        },
        {
          "old": "sub_08119C0C",
          "proposed": "SwitchDespawn",
          "baseline_evidence": "Sets generic object flag0x1000; ObjectMain destroys the task on that flag.",
          "limitation": "Deferred destruction by ObjectMain rather than immediate TaskDestroy call."
        }
